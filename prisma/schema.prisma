generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Job {
  id          String    @id @default(cuid())
  title       String
  company     String
  description String
  category    String
  type        String
  location    String
  salaryMin   Int?
  salaryMax   Int?
  applyUrl    String?
  applyEmail  String?
  postedBy    String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  featured    Boolean   @default(false)

  @@index([category])
  @@index([location])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@index([email])
}